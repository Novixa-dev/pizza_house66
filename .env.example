# Copy to .env and fill in real values. `.env` is gitignored — never commit it.
# Every variable is documented in docs/ENVIRONMENT.md.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Prisma's datasource provider is "postgresql"
# and the migrations in prisma/migrations/ are Postgres SQL — SQLite will not
# work (docs/DECISIONS.md, "PostgreSQL, with versioned migrations").
#
# Local:  postgresql://postgres@127.0.0.1:5432/pizzahouse?schema=public
# Hosted: add ?sslmode=require, and use the pooled connection string if the
#         provider offers one — serverless opens a lot of short connections.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/pizzahouse?schema=public"

# Signs staff session cookies. Must be at least 32 characters — the app
# refuses to start a session with anything shorter rather than signing with a
# guessable key. Generate with: openssl rand -hex 32
# Rotating it signs every staff member out; it does not touch orders.
AUTH_SECRET="replace-with-a-long-random-secret"

# ---------------------------------------------------------------------------
# Strongly recommended in production
# ---------------------------------------------------------------------------

# Bearer token for /api/cron/release-orders, the job that moves orders into
# the kitchen queue when their prep time arrives. WITHOUT THIS THE ENDPOINT
# STAYS CLOSED (401) — it fails closed, not open. Generate as above.
# Set the same value in the host's cron configuration.
CRON_SECRET=""

# Public origin, used for canonical URLs, Open Graph tags, the sitemap and
# order-tracking links. On Vercel this is inferred from
# VERCEL_PROJECT_PRODUCTION_URL when unset, but setting it explicitly is what
# pins canonical URLs to the restaurant's real domain.
# Exposed to the browser (NEXT_PUBLIC_ prefix) — never put a secret here.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Development and tooling only
# ---------------------------------------------------------------------------

# Password given to the demo accounts created by `npm run db:seed`.
# Defaults to ChangeMe123!. Never deploy seeded demo accounts to production —
# use `npm run staff:create` instead (docs/HANDOVER.md).
SEED_STAFF_PASSWORD=""
