# Copy to .env and fill in real values before running the app.
# See docs/ENVIRONMENT.md for full documentation of every variable.

# Database — SQLite file for local/demo use (see docs/DECISIONS.md).
# Production should point this at a managed PostgreSQL instance instead
# (Prisma datasource provider must be changed from "sqlite" to "postgresql").
DATABASE_URL="file:./dev.db"

# Session signing secret for admin/kitchen auth cookies (required).
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Public base URL, used to build absolute links (order tracking, etc).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
