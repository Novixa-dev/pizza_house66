# Written by install.sh; shown here so every setting is documented in one
# place. `.env` holds secrets — it is gitignored and created with mode 600.

# The public address. The A record for it must point at this server.
DOMAIN=pizza-house66.novixa.dev

# Let's Encrypt writes here if a certificate is about to expire unrenewed.
ACME_EMAIL=owner@example.com

# Generated: openssl rand -hex 24 / 32 / 32.
# Changing DB_PASSWORD after the first start does NOT change it inside the
# existing database; see docs/DEPLOY-VPS.md before touching it.
DB_PASSWORD=
# Signs staff sessions. Rotating it signs every staff member out.
AUTH_SECRET=
# Bearer token for the order-release job (scheduler service).
CRON_SECRET=
